DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PORT=3847
# Optional soft cap on monthly DataForSEO spend, in USD. Blocks new paid calls
# once this month's running total reaches it. Leave blank for no cap.
DATAFORSEO_MONTHLY_BUDGET=

# TypeSafe AI (Jev) — https://api.typesafe.ai. Optional: Jev-driven features
# fall back to the built-in heuristics when this is unset.
JEV_API_KEY=
# Optional; defaults to jev-latest.
JEV_MODEL=
# Optional soft cap on monthly Jev spend, in USD, tracked separately from
# DATAFORSEO_MONTHLY_BUDGET. Leave blank for no cap.
JEV_MONTHLY_BUDGET=
